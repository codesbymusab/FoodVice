{
  "compilerOptions": {
    "target": "ES2020",                  
    "module": "commonjs",                
    "rootDir": "src",  
    "typeRoots": ["./src/types", "./node_modules/@types"],                  
    "outDir": "dist",                    
    "esModuleInterop": true,            
    "allowJs": true,                     
    "checkJs": false,                    
    "strict": true,                      
    "skipLibCheck": true,                
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "express"]
  },
  "include": ["src/**/*.ts","src/**/*.js"],               
  "exclude": ["node_modules", "dist"]
}
